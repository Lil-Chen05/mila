{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mila.example/schemas/part1/validation_report.schema.json",
  "title": "Part 1 machine-readable validation report",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_name", "schema_version", "validation_report_id", "study_id", "model_run_id", "model_run_manifest_hash", "validated_artifact_kind", "validated_artifact_identity", "validation_started_at", "validation_completed_at", "validator_version", "is_valid", "checks", "error_count", "warning_count", "summary"],
  "properties": {
    "schema_name": {"const": "part1_validation_report"},
    "schema_version": {"enum": ["1.0.0", "1.1.0"]},
    "validation_report_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "study_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "model_run_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "model_run_manifest_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "validated_artifact_kind": {"enum": ["question_manifest", "study_manifest", "model_run_manifest", "natural_shard", "checkpoint_shard", "audit_shard", "merged_results", "production_coverage"]},
    "validated_artifact_identity": {"type": "string", "minLength": 1},
    "validation_started_at": {"type": "string", "format": "date-time"},
    "validation_completed_at": {"type": "string", "format": "date-time"},
    "validator_version": {"type": "string", "minLength": 1},
    "is_valid": {"type": "boolean"},
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "outcome", "details"],
        "properties": {
          "name": {"type": "string"},
          "outcome": {"enum": ["passed", "failed", "warning"]},
          "details": {"type": "object"}
        }
      }
    },
    "error_count": {"type": "integer", "minimum": 0},
    "warning_count": {"type": "integer", "minimum": 0},
    "summary": {"type": "object"},
    "structurally_valid": {"type": "boolean"},
    "coverage_complete": {"type": "boolean"},
    "paper_analysis_ready": {"type": "boolean"},
    "source_files": {"$ref": "#/$defs/sourceFiles"}
  },
  "$defs": {
    "sourceFiles": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/sourceFile"}
    },
    "sourceFile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["relative_path", "shard_id", "kind", "state", "sha256", "byte_size"],
      "properties": {
        "relative_path": {"type": "string", "minLength": 1},
        "shard_id": {
          "anyOf": [
            {"type": "null"},
            {"type": "string", "pattern": "^shard-(?:[0-3][0-9]{2}|4[0-9]{2})$"}
          ]
        },
        "kind": {
          "enum": ["questions", "question_manifest", "study_manifest", "model_run_manifest", "dependency_lock", "shard_provenance", "natural_results", "checkpoint_results", "audit_events", "finalization_marker", "runtime_guard", "takeover_evidence", "recovery_evidence", "quarantined_bytes", "lock_history", "unexpected_raw_entry", "unexpected_file"]
        },
        "state": {"enum": ["regular_file", "absent"]},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "byte_size": {"type": "integer", "minimum": 0}
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {"enum": ["questions", "question_manifest", "study_manifest", "model_run_manifest", "dependency_lock", "unexpected_raw_entry"]}
            }
          },
          "then": {"properties": {"shard_id": {"const": null}}}
        },
        {
          "if": {
            "properties": {
              "kind": {"enum": ["shard_provenance", "natural_results", "checkpoint_results", "audit_events", "finalization_marker", "runtime_guard", "takeover_evidence", "recovery_evidence", "quarantined_bytes", "lock_history", "unexpected_file"]}
            }
          },
          "then": {
            "properties": {
              "shard_id": {"type": "string", "pattern": "^shard-(?:[0-3][0-9]{2}|4[0-9]{2})$"}
            }
          }
        }
      ]
    },
    "naturalPartition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["complete", "terminal_infrastructure_failure", "retryable_incomplete", "missing", "duplicate", "schema_incompatible", "manifest_incompatible"],
      "properties": {
        "complete": {"type": "integer", "minimum": 0},
        "terminal_infrastructure_failure": {"type": "integer", "minimum": 0},
        "retryable_incomplete": {"type": "integer", "minimum": 0},
        "missing": {"type": "integer", "minimum": 0},
        "duplicate": {"type": "integer", "minimum": 0},
        "schema_incompatible": {"type": "integer", "minimum": 0},
        "manifest_incompatible": {"type": "integer", "minimum": 0}
      }
    },
    "checkpointPartition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["complete", "terminal_infrastructure_failure", "retryable_incomplete", "ineligible", "missing", "duplicate"],
      "properties": {
        "complete": {"type": "integer", "minimum": 0},
        "terminal_infrastructure_failure": {"type": "integer", "minimum": 0},
        "retryable_incomplete": {"type": "integer", "minimum": 0},
        "ineligible": {"type": "integer", "minimum": 0},
        "missing": {"type": "integer", "minimum": 0},
        "duplicate": {"type": "integer", "minimum": 0}
      }
    },
    "naturalMatrix": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dimensions", "rows"],
      "properties": {
        "dimensions": {"const": ["stop_reason", "reasoning_status", "answer_parse_status", "confidence_parse_status"]},
        "rows": {
          "type": "array",
          "minItems": 320,
          "maxItems": 320,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["stop_reason", "reasoning_status", "answer_parse_status", "confidence_parse_status", "count"],
            "properties": {
              "stop_reason": {"enum": ["eos", "max_new_tokens", "stopping_criterion", "error", "other"]},
              "reasoning_status": {"enum": ["closed", "missing_close", "no_reasoning", "malformed"]},
              "answer_parse_status": {"enum": ["parsed", "missing", "malformed", "out_of_domain"]},
              "confidence_parse_status": {"enum": ["parsed", "missing", "malformed", "out_of_range"]},
              "count": {"type": "integer", "minimum": 0}
            }
          }
        }
      }
    },
    "checkpointMatrix": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dimensions", "rows"],
      "properties": {
        "dimensions": {"const": ["checkpoint_model_output_status", "answer_parse_status", "confidence_parse_status", "answer_token_status", "entropy_status"]},
        "rows": {
          "type": "array",
          "minItems": 384,
          "maxItems": 384,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["checkpoint_model_output_status", "answer_parse_status", "confidence_parse_status", "answer_token_status", "entropy_status", "count"],
            "properties": {
              "checkpoint_model_output_status": {"enum": ["valid", "invalid"]},
              "answer_parse_status": {"enum": ["parsed", "missing", "malformed", "out_of_domain"]},
              "confidence_parse_status": {"enum": ["parsed", "missing", "malformed", "out_of_range"]},
              "answer_token_status": {"enum": ["located", "missing", "ambiguous", "unsupported"]},
              "entropy_status": {"enum": ["computed", "unavailable", "invalid"]},
              "count": {"type": "integer", "minimum": 0}
            }
          }
        }
      }
    },
    "coverageSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["question_manifest_hash", "study_manifest_hash", "final_production_git_commit", "observed_git_commit", "dependency_lock_sha256", "clean_tracked_worktree", "expected", "observed", "historical_layout_detected", "natural_partition", "checkpoint_partition", "outcome_counts", "unexpected_physical_record_count", "structural_error_count", "structural_warning_count", "structural_errors", "structural_warnings", "natural_model_output_matrix", "checkpoint_model_output_matrix"],
      "properties": {
        "question_manifest_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "study_manifest_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "final_production_git_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "observed_git_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "dependency_lock_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "clean_tracked_worktree": {"type": "boolean"},
        "expected": {"const": {"questions": 500, "shards": 500, "natural_logical_keys": 5000, "checkpoint_logical_keys": 55000}},
        "observed": {
          "type": "object",
          "additionalProperties": false,
          "required": ["shards", "natural_physical_records", "checkpoint_physical_records", "source_files"],
          "properties": {
            "shards": {"type": "integer", "minimum": 0},
            "natural_physical_records": {"type": "integer", "minimum": 0},
            "checkpoint_physical_records": {"type": "integer", "minimum": 0},
            "source_files": {"type": "integer", "minimum": 0}
          }
        },
        "historical_layout_detected": {"enum": [20, 200, null]},
        "natural_partition": {"$ref": "#/$defs/naturalPartition"},
        "checkpoint_partition": {"$ref": "#/$defs/checkpointPartition"},
        "outcome_counts": {
          "type": "object",
          "additionalProperties": false,
          "required": ["natural_execution_complete", "natural_terminal_infrastructure_failure", "checkpoint_execution_complete", "checkpoint_terminal_infrastructure_failure", "checkpoint_ineligible"],
          "properties": {
            "natural_execution_complete": {"type": "integer", "minimum": 0},
            "natural_terminal_infrastructure_failure": {"type": "integer", "minimum": 0},
            "checkpoint_execution_complete": {"type": "integer", "minimum": 0},
            "checkpoint_terminal_infrastructure_failure": {"type": "integer", "minimum": 0},
            "checkpoint_ineligible": {"type": "integer", "minimum": 0}
          }
        },
        "unexpected_physical_record_count": {"type": "integer", "minimum": 0},
        "structural_error_count": {"type": "integer", "minimum": 0},
        "structural_warning_count": {"type": "integer", "minimum": 0},
        "structural_errors": {"type": "array", "items": {"type": "string"}},
        "structural_warnings": {"type": "array", "items": {"type": "string"}},
        "natural_model_output_matrix": {"$ref": "#/$defs/naturalMatrix"},
        "checkpoint_model_output_matrix": {"$ref": "#/$defs/checkpointMatrix"}
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"schema_version": {"const": "1.0.0"}}},
      "then": {
        "properties": {
          "validated_artifact_kind": {"enum": ["question_manifest", "study_manifest", "model_run_manifest", "natural_shard", "checkpoint_shard", "audit_shard", "merged_results"]}
        },
        "not": {
          "anyOf": [
            {"required": ["structurally_valid"]},
            {"required": ["coverage_complete"]},
            {"required": ["paper_analysis_ready"]},
            {"required": ["source_files"]}
          ]
        }
      }
    },
    {
      "if": {"properties": {"schema_version": {"const": "1.1.0"}}},
      "then": {
        "required": ["structurally_valid", "coverage_complete", "paper_analysis_ready", "source_files"],
        "properties": {
          "validated_artifact_kind": {"const": "production_coverage"},
          "summary": {"$ref": "#/$defs/coverageSummary"},
          "source_files": {"$ref": "#/$defs/sourceFiles"}
        }
      }
    }
  ]
}
