{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mila.example/schemas/part1/model_run_manifest.schema.json",
  "title": "Part 1 operational model-run manifest contract",
  "description": "Schema only. Phase 1 must not create an operational production instance.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_name", "schema_version", "model_run_id", "model_run_manifest_hash", "execution_scope", "study_id", "study_manifest_hash", "question_manifest_hash", "model_repository", "model_revision", "tokenizer_repository", "tokenizer_revision", "canonical_model_identity", "adapter_version", "prompt_version", "prompt_hash", "parser_version", "inducer_version", "inducer_text", "inducer_token_ids", "reasoning_open_tag", "reasoning_open_token_ids", "reasoning_close_tag", "reasoning_close_token_ids", "requested_natural_generation", "effective_natural_generation", "requested_checkpoint_generation", "effective_checkpoint_generation", "ad_token_convention", "ad_raw_token_sequences", "ad_token_ids", "seed_algorithm_version", "base_generation_seed", "environment_versions", "final_production_git_commit", "production", "smoke_git_provenance"],
  "properties": {
    "schema_name": {"const": "part1_model_run_manifest"},
    "schema_version": {"enum": ["1.0.0", "1.1.0"]},
    "model_run_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "model_run_manifest_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "execution_scope": {"enum": ["smoke_a", "smoke_b", "reproducibility", "phase3_smoke", "production"]},
    "study_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "study_manifest_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "question_manifest_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "model_repository": {"type": "string", "minLength": 1},
    "model_revision": {"type": "string", "minLength": 1},
    "tokenizer_repository": {"type": "string", "minLength": 1},
    "tokenizer_revision": {"type": "string", "minLength": 1},
    "canonical_model_identity": {"type": "string", "minLength": 1},
    "adapter_version": {"type": "string", "minLength": 1},
    "prompt_version": {"type": "string", "minLength": 1},
    "prompt_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "parser_version": {"type": "string", "minLength": 1},
    "inducer_version": {"type": "string", "minLength": 1},
    "inducer_text": {"type": "string"},
    "inducer_token_ids": {"type": "array", "items": {"type": "integer", "minimum": 0}},
    "reasoning_open_tag": {"type": "string"},
    "reasoning_open_token_ids": {"type": "array", "items": {"type": "integer", "minimum": 0}},
    "reasoning_close_tag": {"type": "string"},
    "reasoning_close_token_ids": {"type": "array", "items": {"type": "integer", "minimum": 0}},
    "requested_natural_generation": {"type": "object", "minProperties": 1},
    "effective_natural_generation": {"type": "object", "minProperties": 1},
    "requested_checkpoint_generation": {"type": "object", "minProperties": 1},
    "effective_checkpoint_generation": {"type": "object", "minProperties": 1},
    "ad_token_convention": {"type": "string", "minLength": 1},
    "ad_raw_token_sequences": {"type": "object", "required": ["A", "B", "C", "D"], "additionalProperties": false, "properties": {"A": {"type": "array", "items": {"type": "integer"}}, "B": {"type": "array", "items": {"type": "integer"}}, "C": {"type": "array", "items": {"type": "integer"}}, "D": {"type": "array", "items": {"type": "integer"}}}},
    "ad_token_ids": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"type": "integer", "minimum": 0}},
    "seed_algorithm_version": {"const": "part1-seed-v1"},
    "base_generation_seed": {"type": "integer", "minimum": 0},
    "environment_versions": {"type": "object", "minProperties": 1},
    "final_production_git_commit": {"type": ["string", "null"], "pattern": "^[0-9a-f]{40}$"},
    "production": {"type": "boolean"},
    "smoke_git_provenance": {"type": ["object", "null"]},
    "bos_token_id": {"type": ["integer", "null"], "minimum": 0},
    "eos_token_id": {"type": ["integer", "null"], "minimum": 0},
    "pad_token_id": {"type": ["integer", "null"], "minimum": 0},
    "model_context_window": {"type": "integer", "minimum": 1},
    "dependency_lock_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "clean_tracked_worktree": {"const": true},
    "output_paths": {
      "type": "object",
      "additionalProperties": false,
      "required": ["raw_shards", "validation", "merged", "analysis"],
      "properties": {
        "raw_shards": {"type": "string", "pattern": "^results/part1/[0-9a-f]{64}/raw_shards$"},
        "validation": {"type": "string", "pattern": "^results/part1/[0-9a-f]{64}/validation$"},
        "merged": {"type": "string", "pattern": "^results/part1/[0-9a-f]{64}/merged$"},
        "analysis": {"type": "string", "pattern": "^results/part1/[0-9a-f]{64}/analysis$"}
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"production": {"const": true}}},
      "then": {
        "required": ["bos_token_id", "eos_token_id", "pad_token_id", "model_context_window", "dependency_lock_sha256", "clean_tracked_worktree", "output_paths"],
        "properties": {
          "schema_version": {"const": "1.1.0"},
          "execution_scope": {"const": "production"},
          "final_production_git_commit": {"type": "string"},
          "smoke_git_provenance": {"type": "null"}
        }
      }
    },
    {
      "if": {"properties": {"production": {"const": false}}},
      "then": {
        "properties": {
          "schema_version": {"const": "1.0.0"},
          "execution_scope": {"enum": ["smoke_a", "smoke_b", "reproducibility", "phase3_smoke"]},
          "final_production_git_commit": {"type": "null"},
          "smoke_git_provenance": {"type": "object"}
        },
        "not": {
          "anyOf": [
            {"required": ["bos_token_id"]},
            {"required": ["eos_token_id"]},
            {"required": ["pad_token_id"]},
            {"required": ["model_context_window"]},
            {"required": ["dependency_lock_sha256"]},
            {"required": ["clean_tracked_worktree"]},
            {"required": ["output_paths"]}
          ]
        }
      }
    }
  ]
}
