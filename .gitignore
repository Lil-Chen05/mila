# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info
.pytest_cache/

# Virtual environments
.venv

# SLURM logs (jobs write to logs/ via #SBATCH --output; root pattern catches strays)
slurm-*.out
logs/*
!logs/.gitkeep

# Datasets and experiment outputs (saved to disk, not version-controlled)
data/
results/*/*.shard*.jsonl

# Generated Part 1 operational manifests, raw shards, events, and reports.
# Historical pilot results are tracked under archive/pilots/20q-200q/.
results/part1-smoke/
results/part1/

# Interrupted CPU materialization staging; finalized manifests remain tracked.
manifests/.part1.materialize-*/

# macOS metadata
.DS_Store

# LaTeX build artifacts (main.tex and main.pdf are tracked; the rest regenerate)
report/*.aux
report/*.bbl
report/*.blg
report/*.fdb_latexmk
report/*.fls
report/*.log
report/*.out
report/build.log

# Recovered-confidence parquet artifacts: regenerable from the merged run via
# scripts/confidence_repair.py, and too large to version.
analysis/final-r5000/confidence/*.parquet
