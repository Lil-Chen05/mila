# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info
.pytest_cache/

# Virtual environments
.venv

# SLURM logs (jobs write to logs/ via #SBATCH --output; root pattern catches strays)
slurm-*.out
logs/*
!logs/.gitkeep

# Datasets and experiment outputs (saved to disk, not version-controlled)
data/
results/*/*.shard*.jsonl

# Generated Part 1 operational manifests, raw shards, events, and reports.
# Historical results/20q and results/200q remain tracked and unaffected.
results/part1-smoke/
results/part1/

# Interrupted CPU materialization staging; finalized manifests remain tracked.
manifests/.part1.materialize-*/
